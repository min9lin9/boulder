{
  "name": "boulder-oss-cli",
  "version": "0.1.16",
  "description": "A min9lin9 operator kit for turning OSS repositories into evidence-backed Codex workflows.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/min9lin9/boulder.git"
  },
  "homepage": "https://github.com/min9lin9/boulder#readme",
  "bugs": {
    "url": "https://github.com/min9lin9/boulder/issues"
  },
  "bin": {
    "boulder": "bin/boulder.js",
    "boulder-oss-cli": "bin/boulder.js"
  },
  "scripts": {
    "build": "bun build bin/boulder.ts --outdir /tmp/boulder-build --target bun",
    "boulder": "bun bin/boulder.ts",
    "ci": "bun run smoke && bun run build && bun run pack:dry-run",
    "pack:dry-run": "bun pm pack --dry-run --ignore-scripts",
    "smoke": "bun bin/boulder.ts --help && bun test",
    "test": "bun test"
  },
  "keywords": [
    "codex",
    "oss",
    "maintainer",
    "agent",
    "cli",
    "workflow",
    "verification"
  ],
  "files": [
    "bin",
    "src",
    "docs",
    "fixtures",
    "skills/boulder",
    "skills/boulder-bootstrap-designer",
    "README.md",
    "boulder.yaml",
    "LICENSE",
    "CHANGELOG.md",
    "ROADMAP.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "!docs/*SESSION_SUMMARY*.md",
    "!docs/NEXT_*GAP*PLAN*.md",
    "!**/* 2.*"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
